# ==============================================================================
# FIREBASE CLIENT CONFIGURATION
# Didapatkan dari: Firebase Console > Project Settings > General > Your apps (Web)
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyExampleKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="bougenville-sc.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="bougenville-sc"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="bougenville-sc.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ==============================================================================
# ADMIN ALLOWLIST
# Daftar alamat email untuk 2 orang pengelola resmi klub (dipisahkan tanda koma)
# Hanya akun dengan email di bawah ini yang dapat mengakses dashboard /admin
# ==============================================================================
ADMIN_EMAILS="admin1@bougenville.sc,admin2@bougenville.sc"

# ==============================================================================
# FIREBASE ADMIN SDK (Opsional)
# String JSON Service Account Key jika ingin bypass Security Rules dari server.
# ==============================================================================
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'
